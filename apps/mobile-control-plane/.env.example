# Required authentication secrets. Generate long random values and keep them in the hosting secret store.
CONTROL_PLANE_ACCESS_KEY=
CONTROL_PLANE_SESSION_SECRET=

# Scope the control plane to explicit repositories only.
CONTROL_PLANE_REPOSITORIES=EVENTo0/AAA-prompt-empire,EVENTo0/AAA-prompt
CONTROL_PLANE_ENABLE_WRITES=false
CONTROL_PLANE_ALLOWED_WORKFLOWS=android.yml,ios.yml,preview.yml

# GitHub fine-grained token: read metadata/actions/deployments; Actions write only if write actions are enabled.
GITHUB_TOKEN=

# Optional Vercel read integration.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional Vercel deploy-hook map, e.g. {"AAA-prompt-empire":"https://api.vercel.com/v1/integrations/deploy/..."}
VERCEL_DEPLOY_HOOKS_JSON={}

# Optional Supabase Management API integration. PAT stays server-only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REFS=

# Optional EVENTO catalog adapter. The endpoint should return {"projects": [...]}.
EVENTO_CATALOG_URL=
EVENTO_CATALOG_TOKEN=
