{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVENTO",
  "version": "0.1.0",
  "identifier": "ae.evento.control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EVENTO Control Plane",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "../daemon/evento_daemon.py",
      "../../../registry/evento-connectors.json",
      "../../../registry/evento-local-actions.json",
      "../../../registry/evento-local-write-actions.json",
      "../../../registry/evento-project-workspaces.json"
    ],
    "windows": {
      "bundleVCRuntime": true
    }
  }
}
