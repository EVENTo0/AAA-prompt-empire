# EVENTO Desktop daemon
# Generate high-entropy values locally. Never commit real values.
EVENTO_DAEMON_TOKEN=
EVENTO_ENABLE_WRITES=false
EVENTO_DAEMON_WRITE_TOKEN=
# Optional comma-separated absolute roots. Defaults to .evento-workspaces under the repo.
EVENTO_WORKSPACE_ROOTS=
EVENTO_DAEMON_PORT=8765

# Optional device-specific project roots. Keep real paths local; do not commit them.
EVENTO_WORKSPACE_EVENTO_ACQUISITION=
EVENTO_WORKSPACE_EVENTO_ONE=
EVENTO_WORKSPACE_EVENTO_MOBILE=
EVENTO_WORKSPACE_AAA_EMPIRE=

# Optional explicit tool paths. Recommended when Blender/Unity are not on PATH.
EVENTO_BLENDER_EXECUTABLE=
EVENTO_UNITY_EDITOR=

EVENTO_ADB_EXECUTABLE=

EVENTO_CODEX_EXECUTABLE=
EVENTO_CLAUDE_EXECUTABLE=
