{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evento.local/schemas/memory.schema.json",
  "title": "EVENTO Memory Item v1",
  "type": "object",
  "required": ["id","title","memory_type","domain","summary","validation_state","scope"],
  "properties": {
    "id": {"type":"string","minLength":3},
    "title": {"type":"string","minLength":3},
    "memory_type": {"enum":["fact","decision","lesson","pattern","anti_pattern","rule","source_claim","asset_knowledge"]},
    "domain": {"type":"string","minLength":2},
    "summary": {"type":"string","minLength":1},
    "rule": {"type":["string","null"]},
    "trigger": {"type":["string","null"]},
    "project_id": {"type":["string","null"]},
    "scope": {"enum":["task","project","domain","evento_shared"]},
    "validation_state": {"enum":["observed","proposed","supported","verified","active","deprecated","superseded"]},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "applies_to": {"type":"array","items":{"type":"string"}},
    "evidence": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["kind","ref"],
        "properties":{
          "kind":{"enum":["url","document","commit","pr","ci","test","build","database_record","manual_review"]},
          "ref":{"type":"string"},
          "note":{"type":["string","null"]}
        },
        "additionalProperties":false
      }
    },
    "superseded_by": {"type":["string","null"]},
    "created_at": {"type":["string","null"],"format":"date-time"},
    "last_verified_at": {"type":["string","null"],"format":"date-time"}
  },
  "additionalProperties": false
}