{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://evento.local/schemas/evento-task.schema.json",
  "title":"EVENTO Task v1",
  "type":"object",
  "required":["task_id","project_id","objective","acceptance_criteria","risk","mode"],
  "properties":{
    "task_id":{"type":"string","minLength":3},
    "project_id":{"type":"string","minLength":2},
    "objective":{"type":"string","minLength":3},
    "acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},
    "non_goals":{"type":"array","items":{"type":"string"}},
    "target_platforms":{"type":"array","items":{"type":"string"}},
    "mode":{"enum":["plan","build","verify","preview","release","learn"]},
    "risk":{"enum":["low","medium","high","critical"]},
    "required_evidence":{"type":"array","items":{"type":"string"}},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "allowed_actions":{"type":"array","items":{"type":"string"}},
    "forbidden_actions":{"type":"array","items":{"type":"string"}},
    "deployment_trigger":{"type":["string","null"]},
    "rollback":{"type":["string","null"]},
    "budget_cap":{"type":["number","null"],"minimum":0},
    "preferred_agents":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["queued","planning","active","blocked","verifying","preview","awaiting_approval","done","cancelled"]}
  },
  "additionalProperties":false
}